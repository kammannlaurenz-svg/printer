# -----------------------------------------------------------
# Vorlage. Kopiere diese Datei zu ".env" (im selben Ordner)
# und trage deine Werte ein. Die .env wird NICHT geteilt/committed.
# -----------------------------------------------------------

SUPABASE_URL=https://jyogmhegflsstuepisfl.supabase.co

# Der GEHEIME "Secret key" aus Supabase (beginnt mit sb_secret_...):
# Project Settings -> API keys -> "Secret keys" erzeugen/anzeigen.
# (frueher hiess dieser Key "service_role")
# NIEMALS ins Frontend/Web packen!
SUPABASE_SERVICE_KEY=hier_deinen_secret_key_einfuegen

# Name des Druckers unter Windows (Systemsteuerung -> Geraete und Drucker)
PRINTER_NAME=TM-T88IV

# Sekunden zwischen zwei Abfragen
CHECK_SECONDS=2

# Bildbreite in Pixeln (TM-T88IV: 384 sicher, bis ~500 testbar)
IMAGE_WIDTH=384

# Gedruckte Auftraege nach so vielen Tagen automatisch loeschen (0 = nie)
CLEANUP_DAYS=14
